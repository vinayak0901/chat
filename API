@PostMapping("/positionDashboard")
public ResponseEntity<byte[]> positionDashboard(@RequestBody RequestDto request) throws Exception {

    Object response = service.getPositionDashboard(request);

    byte[] bytes = objectMapper.writeValueAsBytes(response);

    return ResponseEntity.ok()
            .contentType(MediaType.APPLICATION_JSON)
            .contentLength(bytes.length)
            .body(bytes);
}

